# Copy to .env and source it, or export these in your SLURM job script.

# offline (default, and what compute nodes should use) | online | disabled
WANDB_MODE=offline
WANDB_PROJECT=tfm-distill-multiplicity
# WANDB_ENTITY=your-team

# tabicl (default) | mock. The mock backend is a logistic regression stand-in that
# lets the whole pipeline run without TabICLv2 installed. It is for smoke tests only.
TFMDM_TABICL_BACKEND=tabicl

# Set to 1 to let a run start from a dirty working tree. Off by default: a figure
# that cannot be traced to a commit is not a result.
ALLOW_DIRTY=0
